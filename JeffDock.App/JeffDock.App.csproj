<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JeffDock.Core\JeffDock.Core.csproj" />
    <ProjectReference Include="..\JeffDock.PluginContracts\JeffDock.PluginContracts.csproj" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.MouseMover\JeffDock.Plugins.MouseMover.csproj" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.Timer\JeffDock.Plugins.Timer.csproj" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.Game\JeffDock.Plugins.Game.csproj" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.PiHole\JeffDock.Plugins.PiHole.csproj" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.System\JeffDock.Plugins.System.csproj" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Icons\Packs\**\*.png" />
    <Resource Include="Assets\Icons\Packs\**\*.jpg" />
    <Resource Include="Assets\Icons\Packs\**\*.jpeg" />
    <Resource Include="Assets\Icons\Packs\**\*.svg" />
    <Resource Include="Assets\Icons\Packs\**\pack.json" />
    <Resource Include="Assets\Icons\Packs\**\LICENSE.txt" />
    <EmbeddedResource Include="Assets\Presets\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>AJeff</AssemblyName>
    <RootNamespace>JeffDock.App</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
