<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JeffDock.Core\JeffDock.Core.csproj" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\Packs\**\*.png" />
    <Resource Include="Assets\Icons\Packs\**\*.jpg" />
    <Resource Include="Assets\Icons\Packs\**\*.jpeg" />
    <Resource Include="Assets\Icons\Packs\**\*.svg" />
    <Resource Include="Assets\Icons\Packs\**\pack.json" />
    <Resource Include="Assets\Icons\Packs\**\LICENSE.txt" />
    <EmbeddedResource Include="Assets\Presets\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
