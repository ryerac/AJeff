<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JeffDock.Core\JeffDock.Core.csproj" />
    <ProjectReference Include="..\JeffDock.PluginContracts\JeffDock.PluginContracts.csproj" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.MouseMover\JeffDock.Plugins.MouseMover.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.Timer\JeffDock.Plugins.Timer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\JeffDock.Plugins\JeffDock.Plugins.Game\JeffDock.Plugins.Game.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\Packs\**\*.png" />
    <Resource Include="Assets\Icons\Packs\**\*.jpg" />
    <Resource Include="Assets\Icons\Packs\**\*.jpeg" />
    <Resource Include="Assets\Icons\Packs\**\*.svg" />
    <Resource Include="Assets\Icons\Packs\**\pack.json" />
    <Resource Include="Assets\Icons\Packs\**\LICENSE.txt" />
    <EmbeddedResource Include="Assets\Presets\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <Target Name="CopyOfficialPlugins" AfterTargets="Build">
    <ItemGroup>
      <OfficialPluginFiles Include="..\JeffDock.Plugins\JeffDock.Plugins.MouseMover\bin\$(Configuration)\net10.0-windows\JeffDock.Plugins.MouseMover.dll" />
      <OfficialPluginFiles Include="..\JeffDock.Plugins\JeffDock.Plugins.MouseMover\plugin.json" />
      <OfficialTimerPluginFiles Include="..\JeffDock.Plugins\JeffDock.Plugins.Timer\bin\$(Configuration)\net10.0-windows\JeffDock.Plugins.Timer.dll" />
      <OfficialTimerPluginFiles Include="..\JeffDock.Plugins\JeffDock.Plugins.Timer\plugin.json" />
      <OfficialGamePluginFiles Include="..\JeffDock.Plugins\JeffDock.Plugins.Game\bin\$(Configuration)\net10.0-windows\JeffDock.Plugins.Game.dll" />
      <OfficialGamePluginFiles Include="..\JeffDock.Plugins\JeffDock.Plugins.Game\plugin.json" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Plugins\MouseMover" />
    <Copy SourceFiles="@(OfficialPluginFiles)" DestinationFolder="$(OutDir)Plugins\MouseMover" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\Timer" />
    <Copy SourceFiles="@(OfficialTimerPluginFiles)" DestinationFolder="$(OutDir)Plugins\Timer" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\Game" />
    <Copy SourceFiles="@(OfficialGamePluginFiles)" DestinationFolder="$(OutDir)Plugins\Game" SkipUnchangedFiles="true" />
  </Target>

</Project>
