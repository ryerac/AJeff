<Window x:Class="JeffDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="JeffDock Monitor" Height="620" Width="1280" MinHeight="540" MinWidth="1080">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#DDD">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Connected Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top" Text="Auto-discovered from registered AJAZZ profiles" Foreground="#666" Margin="0,0,0,8" />
                <ListBox x:Name="DevicesListBox"
                         SelectionChanged="DevicesListBox_OnSelectionChanged"
                         DisplayMemberPath="DisplayName" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#DDD">
            <DockPanel>
                <TextBlock x:Name="SelectedDeviceTitle"
                           DockPanel.Dock="Top"
                           Text="Raw Input Log"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Showing latest 100 lines"
                           Foreground="#666"
                           Margin="0,0,0,8" />

                <Border DockPanel.Dock="Top" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
                    <Viewbox Height="230" Stretch="Uniform" HorizontalAlignment="Left">
                        <Canvas x:Name="FaceplateCanvas" Width="460" Height="220" />
                    </Viewbox>
                </Border>

                <Border DockPanel.Dock="Top" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Background="#FAFAFA">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Scene" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="SceneComboBox"
                                      Width="180"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="SceneComboBox_OnSelectionChanged" />
                            <Button Content="New" Margin="8,0,0,0" Padding="12,4" Click="NewSceneButton_OnClick" />
                            <Button x:Name="RenameSceneButton"
                                    Content="Rename"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    IsEnabled="False"
                                    Click="RenameSceneButton_OnClick" />
                            <Button x:Name="DeleteSceneButton"
                                    Content="Delete"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    IsEnabled="False"
                                    Click="DeleteSceneButton_OnClick" />
                        </StackPanel>

                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="ResetControlButton"
                                    DockPanel.Dock="Right"
                                    Content="Reset Control"
                                    Padding="10,4"
                                    IsEnabled="False"
                                    Click="ResetControlButton_OnClick" />
                            <TextBlock x:Name="SelectedControlText"
                                       Text="Selected Control: none"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel x:Name="IconBindingRow" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Icon" Width="100" VerticalAlignment="Center" />
                                <ComboBox x:Name="IconModeComboBox"
                                          Width="110"
                                          SelectionChanged="IconModeComboBox_OnSelectionChanged" />
                            </StackPanel>
                            <StackPanel x:Name="StaticIconRow" Orientation="Horizontal" Margin="100,6,0,0">
                                <Button Content="Library..." Padding="12,4" Click="IconLibraryButton_OnClick" />
                                <Button Content="Upload Icon..." Margin="8,0,0,0" Padding="12,4" Click="UploadIconButton_OnClick" />
                                <Button x:Name="RemoveIconButton"
                                        Content="Remove"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        IsEnabled="False"
                                        Click="RemoveIconButton_OnClick" />
                            </StackPanel>
                            <StackPanel x:Name="DynamicIconPanel" Margin="100,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="DynamicIconStateText" Foreground="#666" Margin="0,0,0,4" />
                                <StackPanel x:Name="DynamicIconStatesPanel" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="TurnBindingRow" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Turn Action" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="TurnActionGroupComboBox"
                                      Width="110"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="TurnActionGroupComboBox_OnSelectionChanged" />
                            <ComboBox x:Name="TurnActionComboBox"
                                      Width="160"
                                      Margin="8,0,0,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="TurnActionComboBox_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel x:Name="PressBindingRow" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="PressBindingLabel" Text="Press Action" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="PressActionGroupComboBox"
                                      Width="110"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="PressActionGroupComboBox_OnSelectionChanged" />
                            <ComboBox x:Name="PressActionComboBox"
                                      Width="160"
                                      Margin="8,0,0,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="PressActionComboBox_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel x:Name="KeyboardShortcutRow"
                                    Orientation="Horizontal"
                                    Margin="100,8,0,0"
                                    Visibility="Collapsed">
                            <TextBox x:Name="KeyboardShortcutTextBox"
                                     Width="180"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     ToolTip="The shortcut sent to the currently focused application." />
                            <Button Content="Record..."
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    Click="RecordKeyboardShortcutButton_OnClick" />
                            <Button x:Name="ClearKeyboardShortcutButton"
                                    Content="Clear"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    Click="ClearKeyboardShortcutButton_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="LogListBox"
                         FontFamily="Consolas"
                         FontSize="12"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <Border Grid.Column="4" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#DDD">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Presets" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Drag a preset onto a compatible control."
                           TextWrapping="Wrap"
                           Foreground="#666"
                           Margin="0,0,0,10" />
                <Button DockPanel.Dock="Bottom"
                        Content="Plugins &amp; Settings..."
                        Padding="10,6"
                        Margin="0,10,0,0"
                        Click="PluginSettingsButton_OnClick" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PresetPalettePanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
