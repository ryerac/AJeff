<Window x:Class="JeffDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="JeffDock Monitor" Height="560" Width="980" MinHeight="500" MinWidth="860">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#DDD">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Connected Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top" Text="Auto-discovered from registered AJAZZ profiles" Foreground="#666" Margin="0,0,0,8" />
                <ListBox x:Name="DevicesListBox"
                         SelectionChanged="DevicesListBox_OnSelectionChanged"
                         DisplayMemberPath="DisplayName" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#DDD">
            <DockPanel>
                <TextBlock x:Name="SelectedDeviceTitle"
                           DockPanel.Dock="Top"
                           Text="Raw Input Log"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Showing latest 100 lines"
                           Foreground="#666"
                           Margin="0,0,0,8" />

                <Border DockPanel.Dock="Top" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
                    <Viewbox Height="230" Stretch="Uniform" HorizontalAlignment="Left">
                        <Canvas x:Name="FaceplateCanvas" Width="460" Height="220" />
                    </Viewbox>
                </Border>

                <Border DockPanel.Dock="Top" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Background="#FAFAFA">
                    <StackPanel>
                        <TextBlock x:Name="SelectedControlText"
                                   Text="Selected Control: none"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <StackPanel x:Name="TurnBindingRow" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Turn Action" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="TurnActionComboBox" Width="200" SelectionChanged="TurnActionComboBox_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel x:Name="PressBindingRow" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="PressBindingLabel" Text="Press Action" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="PressActionComboBox" Width="200" SelectionChanged="PressActionComboBox_OnSelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="LogListBox"
                         FontFamily="Consolas"
                         FontSize="12"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
