<ui:FluentWindow x:Class="JeffDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AJeff" Icon="Assets/icon.ico" Height="980" Width="1520" MinHeight="650" MinWidth="1120"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="AJeff" Background="{DynamicResource TitleBarBrush}" />
        <Grid Grid.Row="1" Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Padding="14" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                 Background="{DynamicResource NavigationSurfaceBrush}">
            <DockPanel>
                <Image DockPanel.Dock="Top"
                       Source="Assets/logo.png"
                       Height="88"
                       Stretch="Uniform"
                       Margin="0,0,0,18" />
                <TextBlock DockPanel.Dock="Top" Text="Devices" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top" Text="Connected hardware and simulations" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                <StackPanel x:Name="SimulatorToolsPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
                    <ui:Button Content="Add simulated..." Appearance="Primary"
                               Click="AddSimulatedDeviceButton_OnClick" Margin="0,0,0,8"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <ui:Button x:Name="RemoveSimulatedDeviceButton" Content="Remove simulated" IsEnabled="False"
                            Click="RemoveSimulatedDeviceButton_OnClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="DevicesListBox" SelectionChanged="DevicesListBox_OnSelectionChanged"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border x:Name="SimulationBadge" Grid.Column="1" Background="{DynamicResource SimulatorBadgeBrush}"
                                        CornerRadius="10" Padding="7,2" Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="SIM" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SimulatorBadgeTextBrush}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSimulated}" Value="True">
                                    <Setter TargetName="SimulationBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ui:Card>

        <ui:Card Grid.Column="2" Padding="14" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                 Background="{DynamicResource WorkspaceSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SelectedDeviceTitle"
                           Grid.Row="0"
                           Text="Device"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12" Background="{DynamicResource ThemePanelBrush}">
                    <Viewbox Height="230" Stretch="Uniform" HorizontalAlignment="Left">
                        <Border Background="#25282D" BorderBrush="#3B3F46" BorderThickness="1"
                                CornerRadius="12" Padding="10">
                            <Canvas x:Name="FaceplateCanvas" Width="460" Height="220" />
                        </Border>
                    </Viewbox>
                </Border>

                <TextBlock x:Name="EditingStatusText" Grid.Row="2" TextWrapping="Wrap"
                           Text="Arrow keys select controls. Enter edits. Ctrl+C / Ctrl+V copies and pastes within AJeff."
                           AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />

                <Border x:Name="BindingEditorPanel" Grid.Row="3" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12" Background="{DynamicResource ThemePanelBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Scene" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="SceneComboBox"
                                      AutomationProperties.Name="Scene"
                                      Width="180"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="SceneComboBox_OnSelectionChanged" />
                            <Button Content="New" Margin="8,0,0,0" Padding="12,4" Click="NewSceneButton_OnClick" />
                            <Button x:Name="RenameSceneButton"
                                    Content="Rename"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    IsEnabled="False"
                                    Click="RenameSceneButton_OnClick" />
                            <Button x:Name="DeleteSceneButton"
                                    Content="Delete"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    IsEnabled="False"
                                    Click="DeleteSceneButton_OnClick" />
                        </StackPanel>

                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="ResetControlButton"
                                    DockPanel.Dock="Right"
                                    Content="Reset Control"
                                    Padding="10,4"
                                    IsEnabled="False"
                                    Click="ResetControlButton_OnClick" />
                            <TextBlock x:Name="SelectedControlText"
                                       Text="Selected Control: none"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel x:Name="TurnBindingRow" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Turn Action" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="TurnActionGroupComboBox"
                                      AutomationProperties.Name="Dial turn action group"
                                      Width="110"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="TurnActionGroupComboBox_OnSelectionChanged" />
                            <ComboBox x:Name="TurnActionComboBox"
                                      AutomationProperties.Name="Dial turn action"
                                      Width="160"
                                      Margin="8,0,0,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="TurnActionComboBox_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel x:Name="PressBindingRow" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="PressBindingLabel" Text="Press Action" Width="100" VerticalAlignment="Center" />
                            <ComboBox x:Name="PressActionGroupComboBox"
                                      AutomationProperties.Name="Press action group"
                                      Width="110"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="PressActionGroupComboBox_OnSelectionChanged" />
                            <ComboBox x:Name="PressActionComboBox"
                                      AutomationProperties.Name="Press action"
                                      Width="160"
                                      Margin="8,0,0,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="PressActionComboBox_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel x:Name="KeyboardShortcutRow"
                                    Orientation="Horizontal"
                                    Margin="100,8,0,0"
                                    Visibility="Collapsed">
                            <TextBox x:Name="KeyboardShortcutTextBox"
                                     Width="180"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     ToolTip="The shortcut sent to the currently focused application." />
                            <Button Content="Record..."
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    Click="RecordKeyboardShortcutButton_OnClick" />
                            <Button x:Name="ClearKeyboardShortcutButton"
                                    Content="Clear"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    Click="ClearKeyboardShortcutButton_OnClick" />
                        </StackPanel>

                        <Border x:Name="ButtonSettingsPanel"
                                Margin="100,10,0,0"
                                Padding="10"
                                BorderBrush="#E1E5EC"
                                BorderThickness="1"
                                CornerRadius="7"
                                Background="White"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Button settings" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <StackPanel x:Name="ButtonSettingsFieldsPanel" />
                                <Button Content="Apply settings"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Click="ApplyButtonSettings_OnClick" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="IconBindingRow" Margin="0,10,0,8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Icon" Width="100" VerticalAlignment="Center" />
                                <ComboBox x:Name="IconModeComboBox"
                                          AutomationProperties.Name="Icon mode"
                                          Width="110"
                                          SelectionChanged="IconModeComboBox_OnSelectionChanged" />
                            </StackPanel>
                            <StackPanel x:Name="StaticIconRow" Orientation="Horizontal" Margin="100,6,0,0">
                                <Button Content="Library..." Padding="12,4" Click="IconLibraryButton_OnClick" />
                                <Button Content="Upload Icon..." Margin="8,0,0,0" Padding="12,4" Click="UploadIconButton_OnClick" />
                                <Button x:Name="RemoveIconButton"
                                        Content="Remove"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        IsEnabled="False"
                                        Click="RemoveIconButton_OnClick" />
                            </StackPanel>
                            <StackPanel x:Name="DynamicIconPanel" Margin="100,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="DynamicIconStateText" Foreground="#666" Margin="0,0,0,4" />
                                <StackPanel x:Name="DynamicIconStatesPanel" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <DockPanel Grid.Row="4" Margin="2,0,2,7">
                    <TextBlock DockPanel.Dock="Right"
                               Text="Latest 100 lines"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Activity log" FontWeight="SemiBold" FontSize="14" />
                </DockPanel>

                <ListBox x:Name="LogListBox"
                         Grid.Row="5"
                         FontFamily="Consolas"
                         FontSize="12"
                         HorizontalContentAlignment="Stretch" />
            </Grid>
        </ui:Card>

        <ui:Card Grid.Column="4" Padding="14" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                 Background="{DynamicResource PaletteSurfaceBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Content="Collapse all" Padding="8,3"
                            AutomationProperties.Name="Collapse all preset groups"
                            Click="CollapseAllPresetsButton_OnClick" />
                    <TextBlock Text="Presets" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Drag a preset onto a compatible control, or focus a preset and press Enter to apply it to the selected control."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,12" />
                <ui:Button DockPanel.Dock="Bottom" Appearance="Primary"
                        Content="Plugins &amp; Settings..."
                        Padding="10,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="PluginSettingsButton_OnClick" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PresetPalettePanel" />
                </ScrollViewer>
            </DockPanel>
        </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
