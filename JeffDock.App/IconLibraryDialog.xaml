<Window x:Class="JeffDock.App.IconLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icon Library"
        Height="500"
        Width="700"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Pack" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PackComboBox"
                          Width="180"
                          DisplayMemberPath="Name"
                          SelectionChanged="FilterComboBox_OnSelectionChanged" />
                <TextBlock Text="Category" VerticalAlignment="Center" Margin="20,0,8,0" />
                <ComboBox x:Name="CategoryComboBox"
                          Width="180"
                          SelectionChanged="FilterComboBox_OnSelectionChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Search" Width="42" VerticalAlignment="Center" />
                <TextBox x:Name="SearchTextBox" Width="250" TextChanged="SearchTextBox_OnTextChanged" />
                <TextBlock x:Name="ResultCountText" Margin="12,0,0,0" Foreground="#666" VerticalAlignment="Center" />
                <Button x:Name="PreviousPageButton" Content="‹" Width="30" Margin="12,0,0,0" Click="PreviousPageButton_OnClick" />
                <Button x:Name="NextPageButton" Content="›" Width="30" Margin="4,0,0,0" Click="NextPageButton_OnClick" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border x:Name="ColourPanel" Visibility="Collapsed" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="72" Height="72" Background="#222" CornerRadius="5" Margin="0,0,14,0">
                        <Image x:Name="SelectedPreviewImage" Stretch="Uniform" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="SVG colours" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Foreground" Width="76" VerticalAlignment="Center" />
                            <TextBox x:Name="ForegroundTextBox" Width="90" Text="#FFFFFF" TextChanged="ColourTextBox_OnTextChanged" />
                            <TextBlock Text="Background" Margin="16,0,6,0" VerticalAlignment="Center" />
                            <TextBox x:Name="BackgroundTextBox" Width="90" Text="#000000" TextChanged="ColourTextBox_OnTextChanged" />
                            <CheckBox x:Name="TransparentBackgroundCheckBox" Content="Transparent" Margin="12,0,0,0" VerticalAlignment="Center" Checked="BackgroundMode_OnChanged" Unchecked="BackgroundMode_OnChanged" />
                        </StackPanel>
                        <TextBlock x:Name="ColourErrorText" Foreground="#C62828" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="88" Padding="10,5" IsCancel="True" />
                <Button x:Name="UseIconButton"
                        Content="Use Icon"
                        Width="88"
                        Padding="10,5"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="UseIconButton_OnClick" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="IconsListBox"
                     BorderThickness="0"
                     Padding="8"
                     SelectionChanged="IconsListBox_OnSelectionChanged"
                     MouseDoubleClick="IconsListBox_OnMouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="110" Margin="5">
                            <Border Width="80" Height="80" Background="#222" CornerRadius="5" HorizontalAlignment="Center">
                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"
                                       ToolTip="{Binding Id}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
