<Window x:Class="JeffDock.App.IconLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icon Library"
        Height="500"
        Width="700"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Pack" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="PackComboBox"
                      Width="180"
                      DisplayMemberPath="Name"
                      SelectionChanged="FilterComboBox_OnSelectionChanged" />
            <TextBlock Text="Category" VerticalAlignment="Center" Margin="20,0,8,0" />
            <ComboBox x:Name="CategoryComboBox"
                      Width="180"
                      SelectionChanged="FilterComboBox_OnSelectionChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="88" Padding="10,5" IsCancel="True" />
            <Button x:Name="UseIconButton"
                    Content="Use Icon"
                    Width="88"
                    Padding="10,5"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="UseIconButton_OnClick" />
        </StackPanel>

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="IconsListBox"
                     BorderThickness="0"
                     Padding="8"
                     SelectionChanged="IconsListBox_OnSelectionChanged"
                     MouseDoubleClick="IconsListBox_OnMouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="110" Margin="5">
                            <Border Width="80" Height="80" Background="#222" CornerRadius="5" HorizontalAlignment="Center">
                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"
                                       ToolTip="{Binding Id}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
